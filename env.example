# ============================================================
# Discord Moderation Sync Bot - Example Environment File
# Copy this file to `.env` and replace placeholder values.
# ============================================================

# Discord bot token from the Discord Developer Portal.
# NEVER commit your real token.
DISCORD_TOKEN=

# Comma-separated Discord user IDs allowed to use owner slash commands.
BOT_OWNER_IDS=

# Microsoft OAuth app credentials for nation registration.
# MS_REDIRECT_URI must exactly match the redirect URI in your Microsoft app registration.
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_REDIRECT_URI=https://example.com/oauth/microsoft/callback
NATION_OAUTH_HOST=0.0.0.0
NATION_OAUTH_PORT=8080
NATION_OAUTH_STATE_TTL_SECONDS=600
WHITELIST_EXPORT_PATH=/api/whitelist
WHITELIST_EXPORT_TOKEN=

# Everything else is stored in data/moderation.sqlite3.
# Use owner slash commands like /config_set, /config_id_add, and /config_list
# to configure home guild, staff roles, log threads, feature toggles, and bot behavior.
