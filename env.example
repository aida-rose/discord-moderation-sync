# ============================================================
# Discord Moderation Sync Bot - Example Environment File
# Copy this file to `.env` and replace placeholder values.
# ============================================================

# Discord bot token from the Discord Developer Portal.
# NEVER commit your real token.
DISCORD_TOKEN=

# Comma-separated Discord user IDs allowed to use owner slash commands.
BOT_OWNER_IDS=

# Optional Minecraft RCON credentials.
# These are only used when ENABLE_MC_WHITELIST is true in /config_set.
MC_RCON_HOST=
MC_RCON_PORT=25575
MC_RCON_PASSWORD=

# Private HTTP endpoint used by the verification Minecraft server plugin.
# Keep the token secret; the plugin must use the same value.
MC_VERIFY_API_HOST=127.0.0.1
MC_VERIFY_API_PORT=8765
MC_VERIFY_API_TOKEN=

# Everything else is stored in data/moderation.sqlite3.
# Use owner slash commands like /config_set, /config_id_add, and /config_list
# to configure home guild, staff roles, log threads, feature toggles, and bot behavior.
